.env
node_modules/
.DS_Store
apps/*/scripts/*.png

# Local dev artifacts — keep them out of the public repo.
# Screenshots from headless-Chrome driver runs (root + version series).
/0[0-9]-*.png
/v[0-9]*-*.png
# Session handoff notes (working memory, not documentation).
HANDOFF.md
# Belongs to a separate project (api.digiscope.me status service), not this repo.
deploy/digidollar-status-service.mjs
deploy/oracle-price-feeder.mjs
deploy/README-digidollar-status.md

# Recovery notes for a specific mainnet position — links real wallets on-chain.
# Keep with the cold-wallet backup, never in the repo.
RECOVERY.md
scripts/recovery-position.json

# Python bytecode. A compiled .pyc bakes the ABSOLUTE PATH of the machine that
# built it into its co_filename constant, so committing one publishes somebody's
# home directory. One arrived this way from upstream and was staged for the
# public repo before the pre-publish audit caught it.
__pycache__/
*.pyc
